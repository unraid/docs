{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Keep pnpm on the major that passes Cloudflare Workers Builds.",
      "matchPackageNames": ["pnpm"],
      "allowedVersions": "<11"
    },
    {
      "description": "The glossary plugin generates the React Tooltip 5 HTML attribute.",
      "matchPackageNames": ["react-tooltip"],
      "allowedVersions": "<6"
    }
  ]
}
